{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Card Studio",
  "version": "1.0.0",
  "identifier": "com.cardstudio.app",
  "build": {
    "frontendDist": "../src-web",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "windows": [
      {
        "title": "Card Studio · 闪卡工坊",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
